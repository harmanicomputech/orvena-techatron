# Apache / cPanel / DirectAdmin hosting for the static export (upload the contents of out/).
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS (remove these two lines until SSL is active)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Old techatronagency.com URLs → new structure
  RewriteRule ^services/(website-development|software-development|mobile-app-development|digital-marketing|brand-and-design|cloud-infrastructure|systems-integration|managed-it|cybersecurity|technology-consulting)/?$ /services/ [L,R=301]
  RewriteRule ^approach/?$ /about/ [L,R=301]

  # Add the trailing slash the export uses
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\.[a-z0-9]+$ [NC]
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
